# Copia este archivo como .env.local y ajusta los valores. Los .env reales NUNCA se suben al repositorio.

# URL de la API (sin barra al final).
# Local:       http://localhost:3000
# Producción:  https://backend-api-ygz0.onrender.com   (se define en Vercel → Settings → Environment Variables)
VITE_API_URL=http://localhost:3000

# URL del servidor de tiempo real (chat y personas en la sala), sin barra al final.
# Local:       http://localhost:3001
# Producción:  la URL de backend-realtime en Render (se define en Vercel → Environment Variables)
VITE_REALTIME_URL=http://localhost:3001

# Firebase Authentication (solo autenticación: el frontend nunca usa Firestore).
# Se copian de la consola de Firebase → Configuración del proyecto → Tus apps → App web.
# Estos valores identifican el proyecto y son públicos por diseño, pero igual van en .env.local y no en el código.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Modo mock: con true, POST /api/v1/users, GET /api/v1/users/me y POST /api/v1/users/me/username
# se simulan en el navegador (incluye los errores USERNAME_TAKEN, EMAIL_TAKEN y VALIDATION).
# Firebase Auth sigue siendo real. Déjalo en false (o sin definir) en producción.
VITE_USE_MOCKS=false

# Con VITE_USE_MOCKS=true, además, las salas (/api/v1/rooms) y el chat en tiempo real se simulan en el navegador.
# Con VITE_MOCK_SESION=true también se simula la sesión (entra como «camila») y no hace falta Firebase.
# Solo para desarrollo: déjalo en false (o sin definir) en producción.
VITE_MOCK_SESION=false
