# Copia este archivo como .env.local y ajusta los valores. Los .env reales NUNCA se suben al repositorio.

# URL de la API (sin barra al final).
# Local:       http://localhost:3000
# Producción:  https://backend-api-ygz0.onrender.com   (se define en Vercel → Settings → Environment Variables)
VITE_API_URL=http://localhost:3000

# Firebase Authentication (solo autenticación: el frontend nunca usa Firestore).
# Se copian de la consola de Firebase → Configuración del proyecto → Tus apps → App web.
# Estos valores identifican el proyecto y son públicos por diseño, pero igual van en .env.local y no en el código.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
